<% content_for :title, t("shiplog.roadmap.title") %>
<%= render layout: "shiplog/page", locals: { name: "roadmap" } do %>
  <%= render "shiplog/page_header", title: t("shiplog.roadmap.title"), lede: t("shiplog.roadmap.lede") %>
  <div class="<%= shiplog_class(:columns) %>">
    <% @columns.each do |column, items| %>
      <%= render "shiplog/roadmaps/column", column:, entries: items.map(&:entry) %>
    <% end %>
  </div>
<% end %>
