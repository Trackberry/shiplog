<%# locals: (title:, lede: nil) %>
<%# the page heading and the switcher to the other product updates pages; the texts come from I18n (shiplog.<page>.title / .lede) %>
<header class="<%= shiplog_class(:page_header) %>">
  <h1 class="<%= shiplog_class(:page_title) %>"><%= title %></h1>
  <% if lede.present? %><p class="<%= shiplog_class(:page_lede) %>"><%= lede %></p><% end %>
  <%= render "shiplog/switcher" %>
</header>
