<%# locals: (newer_path: nil, older_path: nil) %>
<%# previous/next page links; renders nothing when both are nil %>
<% if newer_path || older_path %>
  <nav class="<%= shiplog_class(:pagination) %>" aria-label="<%= t("shiplog.changelog.pagination.label", default: "Pagination") %>">
    <% if newer_path %>
      <%= link_to t("shiplog.changelog.pagination.newer", default: "Newer"), newer_path, class: shiplog_class(:pagination_link, :newer), rel: "prev" %>
    <% end %>
    <% if older_path %>
      <%= link_to t("shiplog.changelog.pagination.older", default: "Older"), older_path, class: shiplog_class(:pagination_link, :older), rel: "next" %>
    <% end %>
  </nav>
<% end %>
