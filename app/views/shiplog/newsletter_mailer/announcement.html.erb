<%# The newsletter's HTML part: one 600px table column (fluid below that), every style inline (email clients drop
    stylesheets), absolute image URLs with a width and an alt text, light colours that hold up when a client inverts
    them for dark mode. @content is a Shiplog::Newsletter::Content: title, month, intro_html / highlights / rest_html
    when the split rule applies (see Content), else the whole body as html; @unsubscribe_url and @preferences_url are
    the recipient's own links. Copy this file into your app to change the design; keep the unsubscribe and preferences
    links and the postal address (the List-Unsubscribe headers are set by the mailer). %>
<% palette = shiplog_mail_palette %>
<% font = shiplog_mail_font %>
<% accent = @content.accent %>
<% split = @content.highlights_shown? %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title><%= @content.title %></title>
</head>
<body style="margin:0;padding:0;background-color:<%= palette[:page] %>;color:<%= palette[:text] %>;font-family:<%= font %>;">
<div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:<%= palette[:page] %>;"><%= @content.preheader %></div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= palette[:page] %>;">
<tr>
<td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
<tr>
<td style="padding:0 4px 14px;font-family:<%= font %>;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="font-family:<%= font %>;font-size:16px;font-weight:700;color:<%= palette[:text] %>;vertical-align:middle;">
<% if @content.logo_url %>
<%= image_tag @content.logo_url, alt: @content.product_name, width: 140, style: "display:block;width:140px;max-width:140px;height:auto;border:0;" %>
<% else %>
<%= @content.product_name %>
<% end %>
</td>
<% if @content.view_url %>
<td align="right" style="font-family:<%= font %>;font-size:12px;line-height:1.5;color:<%= palette[:muted] %>;vertical-align:middle;white-space:nowrap;">
<%= link_to t("shiplog.newsletter.mail.view_in_browser"), @content.view_url, style: "color:#{palette[:muted]};text-decoration:underline;" %>
</td>
<% end %>
</tr>
</table>
</td>
</tr>
<tr>
<td style="background-color:<%= palette[:card] %>;border:1px solid <%= palette[:border] %>;border-radius:10px;padding:36px 32px 28px;font-family:<%= font %>;">
<p style="margin:0 0 10px;font-family:<%= font %>;font-size:12px;line-height:1.5;letter-spacing:0.1em;text-transform:uppercase;font-weight:600;color:<%= accent %>;"><%= t("shiplog.categories.announcement", default: "Monthly update") %> · <%= @content.month %></p>
<h1 style="margin:0 0 16px;font-family:<%= font %>;font-size:32px;line-height:1.2;font-weight:800;letter-spacing:-0.01em;color:<%= palette[:text] %>;"><%= @content.title %></h1>
<% if split %>
<%= @content.intro_html %>
<% else %>
<%= @content.html %>
<%= shiplog_mail_button t("shiplog.newsletter.mail.changelog_button"), @content.changelog_url, accent %>
<% end %>
</td>
</tr>
<% if split %>
<% @content.highlights.each do |highlight| %>
<tr>
<td style="padding:16px 0 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= palette[:card] %>;border:1px solid <%= palette[:border] %>;border-radius:10px;">
<% if highlight.image? %>
<tr>
<td style="padding:0;line-height:0;">
<%= shiplog_mail_screenshot(highlight) %>
</td>
</tr>
<% end %>
<tr>
<td style="padding:24px 28px 26px;font-family:<%= font %>;">
<h2 style="margin:0 0 8px;font-family:<%= font %>;font-size:21px;line-height:1.3;font-weight:700;color:<%= palette[:text] %>;"><%= link_to highlight.title, highlight.url, style: "color:#{palette[:text]};text-decoration:none;" %></h2>
<% if highlight.summary.present? %>
<p style="margin:0;font-family:<%= font %>;font-size:16px;line-height:1.6;color:<%= palette[:muted] %>;"><%= highlight.summary %></p>
<% end %>
<%= shiplog_mail_button t("shiplog.newsletter.mail.highlight_button"), highlight.url, accent, margin: "18px 0 0" %>
</td>
</tr>
</table>
</td>
</tr>
<% end %>
<tr>
<td style="padding:16px 0 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= palette[:card] %>;border:1px solid <%= palette[:border] %>;border-radius:10px;">
<tr>
<td style="padding:28px 32px 28px;font-family:<%= font %>;">
<%= @content.rest_html %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;"><tr><td style="border-top:1px solid <%= palette[:border] %>;font-size:0;line-height:0;">&nbsp;</td></tr></table>
<%= shiplog_mail_button t("shiplog.newsletter.mail.changelog_button"), @content.changelog_url, accent, margin: "20px 0 0" %>
</td>
</tr>
</table>
</td>
</tr>
<% end %>
<tr>
<td style="padding:28px 12px 8px;font-family:<%= font %>;font-size:12px;line-height:1.7;color:<%= palette[:muted] %>;text-align:center;">
<%= t("shiplog.newsletter.mail.reason", product: @content.product_name) %><br>
<%= link_to t("shiplog.newsletter.mail.unsubscribe"), @unsubscribe_url, style: "color:#{palette[:muted]};text-decoration:underline;" %>
·
<%= link_to t("shiplog.newsletter.mail.preferences"), @preferences_url, style: "color:#{palette[:muted]};text-decoration:underline;" %>
<% if @content.address.present? %>
<br><%= @content.address %>
<% end %>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
