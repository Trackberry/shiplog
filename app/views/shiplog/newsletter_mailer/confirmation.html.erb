<%# The double opt-in email: a button (and the link as text) the visitor opens to confirm; @subscriber, @confirmation_url
    and @product_name. The link works for 7 days; a page with a button is what it opens (a POST confirms), so a
    link scanner that prefetches it confirms nothing. %>
<% palette = shiplog_mail_palette %>
<% font = shiplog_mail_font %>
<% accent = Shiplog.config.newsletter_accent || "#0969da" %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title><%= t("shiplog.newsletter.mail.confirm_subject", product: @product_name) %></title>
</head>
<body style="margin:0;padding:0;background-color:<%= palette[:page] %>;color:<%= palette[:text] %>;font-family:<%= font %>;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= palette[:page] %>;">
<tr>
<td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
<tr>
<td style="background-color:<%= palette[:card] %>;border-radius:8px;padding:32px;font-family:<%= font %>;">
<% if Shiplog.config.newsletter_logo_url %>
<%= image_tag Shiplog.config.newsletter_logo_url, alt: @product_name, width: 140, style: "display:block;width:140px;max-width:140px;height:auto;border:0;margin:0 0 24px;" %>
<% end %>
<h1 style="margin:0 0 16px;font-family:<%= font %>;font-size:22px;line-height:1.3;font-weight:700;color:<%= palette[:text] %>;"><%= t("shiplog.newsletter.mail.confirm_heading") %></h1>
<p style="margin:0 0 12px;font-family:<%= font %>;font-size:16px;line-height:1.6;color:<%= palette[:text] %>;"><%= t("shiplog.newsletter.mail.confirm_intro", product: @product_name, email: @subscriber.email) %></p>
<%= shiplog_mail_button t("shiplog.newsletter.mail.confirm_button"), @confirmation_url, accent %>
<p style="margin:24px 0 0;font-family:<%= font %>;font-size:13px;line-height:1.6;color:<%= palette[:muted] %>;"><%= t("shiplog.newsletter.mail.confirm_expiry") %></p>
<p style="margin:12px 0 0;font-family:<%= font %>;font-size:12px;line-height:1.6;color:<%= palette[:muted] %>;word-break:break-all;"><%= t("shiplog.newsletter.mail.confirm_link_text") %> <%= link_to @confirmation_url, @confirmation_url, style: "color:#{palette[:muted]};" %></p>
</td>
</tr>
<% if Shiplog.config.newsletter_address.present? %>
<tr>
<td style="padding:24px 12px;font-family:<%= font %>;font-size:12px;line-height:1.7;color:<%= palette[:muted] %>;text-align:center;"><%= Shiplog.config.newsletter_address %></td>
</tr>
<% end %>
</table>
</td>
</tr>
</table>
</body>
</html>
