<tr class="shiplog-entry-row" id="shiplog-entry-<%= entry.id %>">
  <td>
    <%= link_to entry_heading(entry), edit_entry_path(entry, inbox_filter_params) %>
    <%= render "shiplog/admin/entries/badges", entry: %>
    <% if entry.area %>
      <span class="shiplog-badge shiplog-badge--area"><%= entry.area.name %></span>
    <% end %>
    <% if entry.discarded? && entry.discard_reason.present? %>
      <div class="shiplog-admin__muted"><%= entry.discard_reason %></div>
    <% end %>
  </td>
  <td><%= t("shiplog.admin.entries.kinds.#{entry.kind}") %></td>
  <td>
    <%= shiplog_github_link(source_reference(entry.subject), entry.subject.url) %>
  </td>
  <td class="shiplog-admin-table__actions">
    <%= link_to t("shiplog.admin.entries.edit"), edit_entry_path(entry, inbox_filter_params), class: "shiplog-button" %>
    <% if entry.draft? %>
      <%= button_to t("shiplog.admin.entries.approve"), entry_approval_path(entry, inbox_filter_params), class: "shiplog-button shiplog-button--primary", form: { data: { shiplog_inline: true } } %>
      <%= button_to t("shiplog.admin.entries.discard"), entry_discard_path(entry, inbox_filter_params), class: "shiplog-button", form: { data: { shiplog_inline: true } } %>
    <% elsif entry.discarded? %>
      <%= button_to t("shiplog.admin.entries.restore"), entry_discard_path(entry, inbox_filter_params), method: :delete, class: "shiplog-button", form: { data: { shiplog_inline: true } } %>
    <% end %>
  </td>
</tr>
