<h1 class="shiplog-admin__title"><%= t("shiplog.admin.sync.title") %></h1>

<% if @webhook_secret_missing %>
  <p class="shiplog-admin__flash shiplog-admin__flash--alert shiplog-warning" role="alert"><%= t("shiplog.admin.sync.webhook_secret_missing") %></p>
<% end %>
<% if @github_token_missing %>
  <p class="shiplog-admin__flash shiplog-admin__flash--alert shiplog-warning" role="alert"><%= t("shiplog.admin.sync.github_token_missing") %></p>
<% end %>

<div class="shiplog-admin-actions">
  <%= button_to t("shiplog.admin.sync.sync_now"), sync_path, class: "shiplog-button shiplog-button--primary" %>
  <%= button_to t("shiplog.admin.sync.sync_and_scan"), sync_path, params: { scan: "1" }, class: "shiplog-button" %>
</div>

<h2><%= t("shiplog.admin.sync.repositories") %></h2>
<% if @repositories.empty? %>
  <p class="shiplog-admin__empty"><%= t("shiplog.admin.sync.no_repositories") %></p>
<% else %>
  <table class="shiplog-admin-table">
    <thead>
      <tr>
        <th scope="col"><%= t("shiplog.admin.sync.repository") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.synced_at") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.changes_scanned_at") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.last_error") %></th>
      </tr>
    </thead>
    <tbody>
      <% @repositories.each do |full_name, repository| %>
        <tr class="shiplog-repository-row">
          <td><%= full_name %></td>
          <td><%= repository&.synced_at ? l(repository.synced_at, format: :short) : t("shiplog.admin.sync.never") %></td>
          <td><%= repository&.changes_scanned_at ? l(repository.changes_scanned_at, format: :short) : t("shiplog.admin.sync.never") %></td>
          <td><%= repository&.last_error %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2><%= t("shiplog.admin.sync.deliveries") %></h2>
<% if @deliveries.empty? %>
  <p class="shiplog-admin__empty"><%= t("shiplog.admin.sync.no_deliveries") %></p>
<% else %>
  <table class="shiplog-admin-table">
    <thead>
      <tr>
        <th scope="col"><%= t("shiplog.admin.sync.event") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.action") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.repository") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.received_at") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.processed_at") %></th>
        <th scope="col"><%= t("shiplog.admin.sync.error") %></th>
      </tr>
    </thead>
    <tbody>
      <% @deliveries.each do |delivery| %>
        <tr class="shiplog-delivery-row">
          <td><%= delivery.event %></td>
          <td><%= delivery.action %></td>
          <td><%= delivery.repository_full_name %></td>
          <td><%= delivery.received_at && l(delivery.received_at, format: :short) %></td>
          <td><%= delivery.processed_at && l(delivery.processed_at, format: :short) %></td>
          <td><%= delivery.error %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
