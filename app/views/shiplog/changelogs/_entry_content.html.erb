<%# locals: (entry:, heading: "h3", linked: false) %>
<%# what an entry shows: category pill ("New" for features, "Improved" for changes), date, title (a permalink link in the list) and body. The area tag (features and changes only) follows the category. Add images here. %>
<span class="<%= shiplog_class(:entry_category) %>"><%= t("shiplog.categories.#{entry.kind}", default: (entry.feature? ? "New" : "Improved")) %></span>
<% if entry.area && Shiplog::Entry::CHANGELOG_KINDS.include?(entry.kind) %>
  <span class="<%= shiplog_class(:entry_area) %>"><%= entry.area.name %></span>
<% end %>
<time class="<%= shiplog_class(:entry_date) %>" datetime="<%= entry.released_on.iso8601 %>"><%= l(entry.released_on, format: t("shiplog.date_format", default: "%-d %B %Y")) %></time>
<%= content_tag heading, (linked && shiplog_entry_path(entry) ? link_to(entry.title, shiplog_entry_path(entry)) : entry.title), class: shiplog_class(:entry_title) %>
<div class="<%= shiplog_class(:entry_body) %>"><%= simple_format(h(entry.body)) %></div>
