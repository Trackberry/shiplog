<%# locals: (query: nil, count: nil) %>
<%# the changelog search form (GET, works without JavaScript); with a query, also the result summary and a link back to the full changelog %>
<% label = t("shiplog.changelog.search.label", default: "Search the changelog") %>
<form class="<%= shiplog_class(:search) %>" role="search" action="<%= changelog_path %>" method="get">
  <input class="<%= shiplog_class(:search_input) %>" type="search" name="q" value="<%= query %>" aria-label="<%= label %>" placeholder="<%= label %>" maxlength="<%= Shiplog::Entry::SEARCH_MAX_LENGTH %>">
  <button class="<%= shiplog_class(:search_button) %>" type="submit"><%= t("shiplog.changelog.search.submit", default: "Search") %></button>
</form>
<% if query %>
  <p class="<%= shiplog_class(:search_summary) %>">
    <%= t("shiplog.changelog.search.summary", count: count, query: query, default: { one: "%{count} result for “%{query}”", other: "%{count} results for “%{query}”" }) %>
    <%= link_to t("shiplog.changelog.search.clear", default: "Clear search"), changelog_path, class: shiplog_class(:search_clear) %>
  </p>
<% end %>
