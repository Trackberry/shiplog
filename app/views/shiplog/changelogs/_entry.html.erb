<%# locals: (entry:) %>
<%# one changelog entry in the list; the entry itself is the entry_content partial, shared with the permalink page %>
<li class="<%= token_list(shiplog_class(:entry, entry.kind), (shiplog_class(:entry_feature) if entry.feature?)) %>">
  <%= render "shiplog/changelogs/entry_content", entry:, heading: "h3", linked: true %>
</li>
