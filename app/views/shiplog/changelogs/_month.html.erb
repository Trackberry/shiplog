<%# locals: (month:, entries:) %>
<%# one month of the changelog (month is its first day) and its entries, newest first %>
<% dom_id = "shiplog-month-#{month.strftime("%Y-%m")}" %>
<section class="<%= shiplog_class(:month) %>" aria-labelledby="<%= dom_id %>">
  <h2 class="<%= shiplog_class(:month_title) %>" id="<%= dom_id %>"><%= l(month, format: "%B %Y") %></h2>
  <ul class="<%= shiplog_class(:entries) %>">
    <% entries.each do |entry| %>
      <%= render "shiplog/changelogs/entry", entry: %>
    <% end %>
  </ul>
</section>
