<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:title) %></title>
    <% if content_for?(:shiplog_robots) %><meta name="robots" content="<%= content_for(:shiplog_robots) %>"><% end %>
    <% if content_for?(:shiplog_description) %><meta name="description" content="<%= content_for(:shiplog_description) %>"><% end %>
    <%= content_for(:shiplog_og) %>
    <%= content_for(:shiplog_feed) %>
    <%= content_for(:shiplog_structured_data) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body class="shiplog-layout">
    <main>
      <%= yield %>
    </main>
  </body>
</html>
