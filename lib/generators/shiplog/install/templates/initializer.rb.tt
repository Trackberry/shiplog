Shiplog.configure do |config|
  # GitHub repositories to sync ("owner/name"). Sub-issues may cross repositories of the same owner.
  config.repositories = %w[acme/app acme/app-ios]

  # A repository can also be a Hash with options:
  #   changelog: false  keep the repository on the roadmap, but never draft changelog entries from its PRs or commits
  #   gem: "name"       the gem's name in your Gemfile.lock. When a merged PR upgrades it, the changelog gets one
  #                     entry for the upgrade, built from the gem's changes. Needed because names differ
  #                     (a "trackberry-produce" gem can live in acme/produce) and a public gem of the same name
  #                     is not your repository.
  # config.repositories = [
  #   "acme/app",
  #   { name: "acme/app-ios" },
  #   { name: "acme/pricing", changelog: false, gem: "acme-pricing" }
  # ]

  # Lockfile read in merged pull requests to detect gem upgrades (change it for a monorepo).
  # config.lockfile_path = "Gemfile.lock"

  # A String, or a callable evaluated on every GitHub request (e.g. to mint a GitHub App installation token).
  config.github_token = -> { Rails.application.credentials.dig(:github, :shiplog_token) }

  # Secret configured on the GitHub webhook. Without it every webhook delivery is rejected.
  config.webhook_secret = Rails.application.credentials.dig(:github, :shiplog_webhook_secret)

  # Only issues with this label reach the roadmap.
  # config.public_label = "public"

  # Open public issues with one of these labels (or a milestone) are shown as "Coming soon".
  # config.soon_labels = %w[soon]

  # Pull requests with one of these labels never become changelog entries.
  # config.excluded_labels = %w[internal dependencies refactor chore]

  # Authors (Regexp, String or anything responding to ===) whose pull requests and commits are skipped.
  # config.excluded_authors = [/\[bot\]\z/]

  # Conventional-commit types eligible for the changelog.
  # config.commit_types = %w[feat fix perf]

  # Callable that receives the prompt (String) and returns a String containing JSON:
  # {"title": "...", "body": "...", "customer_facing": true}
  # config.rewriter = ->(prompt) { RubyLLM.chat.ask(prompt).content }

  # Used in the built-in prompts.
  # config.product_name = "Acme"
  # config.audience = "small business owners who invoice customers"
  # config.tone = "Friendly, concise, no jargon. Address the customer as 'you'."

  # Optional ->(kind:, context:) { String } that replaces the built-in prompts.
  # config.prompt_builder = nil

  # Read once, when the public controllers load: changing it later has no effect.
  # config.public_parent_controller = "ActionController::Base"
  # config.public_layout = "shiplog/application"

  # Parent class and layout of the admin controllers. Set the parent here (read once, when they load) and
  # point the layout at your admin layout to render the admin inside your app's chrome.
  # config.admin_parent_controller = "ActionController::Base"
  # config.admin_layout = "shiplog/admin"

  # :standalone (default) wraps the admin in Shiplog's own page chrome. Use :hosted when admin_layout is one of
  # your layouts: Shiplog then renders only a compact sub-nav inside your content.
  # config.admin_chrome = :standalone

  # In :hosted mode, render Shiplog's flash messages inside the admin content. Set it to false when your
  # layout already shows the flash.
  # config.admin_flash = true

<% if options[:tailwind] -%>
  # The bundled stylesheet is off: the pages are styled with the Tailwind classes below, added next to
  # the stable shiplog-* BEM classes. Tailwind finds them through the @source line in
  # app/assets/tailwind/application.css (@source "../../../config/initializers/shiplog.rb";).
  config.stylesheet = false

  config.classes = {
<%= tailwind_classes_ruby -%>
  }

<% else -%>
  # Include the bundled stylesheet (CSS variables and @layer shiplog) in the public pages.
  # Set it to false when your app styles the pages itself, for example with Tailwind.
  # config.stylesheet = true

  # Extra classes per element, added to the stable shiplog-* BEM classes (e.g. Tailwind utilities).
  # Keys: <%= Shiplog::Classes::KEYS.join(", ") %>
  # config.classes = {}

<% end -%>
  # Checked by the admin controllers; return false for a 403. It defaults to denying everyone.
  # The line below opens it because the route constraint around the admin mount does the authentication.
  # If the mount is not wrapped in such a constraint, replace it with a real check (e.g. controller.current_user&.admin?).
  config.authorize_admin = ->(controller) { true } # the route constraint around the admin mount does the authentication

  # Recorded as the approver of an entry.
  # config.current_admin = ->(controller) { controller.try(:current_user)&.try(:email) }

  # Public paths, read when routes are drawn.
  # config.roadmap_path = "roadmap"
  # config.changelog_path = "changelog"   # a-z, 0-9, - and _; "docs/news" nests; outer slashes are stripped

  # The site's canonical origin (scheme, host, optional port; no path). The Atom feed's ids and links, og:url
  # and the other absolute URLs use it instead of the request's host, which varies (apex vs www, a forged
  # X-Forwarded-Host). Behind a proxy, also set config.assume_ssl = true (or send X-Forwarded-Proto) in Rails.
  # config.canonical_url = "https://example.com"

  # Pages added to the Roadmap / Changelog switcher. label and path are Strings, or callables evaluated in the
  # view (route helpers, I18n). Render the same switcher on your own pages with `helper Shiplog::SwitcherHelper`
  # and `<%%= shiplog_switcher %>`.
  # config.extra_pages = [ { label: "News", path: -> { main_app.news_path } } ]

  # Names shown on roadmap cards for the repository an item lives in (Strings or callables).
  # config.repository_labels = { "acme/app-ios" => "iPhone & iPad" }

  # How many recently shipped changelog entries the roadmap lists; 0 hides the section.
  # config.roadmap_shipped_count = 4

  # Where the roadmap's "Suggest a feature" link goes (String or callable); no link while nil. Add a footnote
  # next to it with the shiplog.roadmap.footnote translation.
  # config.feedback_path = -> { main_app.new_feedback_path }

  # The public changelog's search box and ?q= filtering. Set to false to turn search off.
  # config.changelog_search = true

  # schema.org structured data (JSON-LD) on the public pages: an Article on each permalink, a CollectionPage on
  # the changelog and the roadmap. Set to false to turn it off.
  # config.structured_data = true

  # "What's new". Shiplog doesn't know your users, so you supply the "last seen" time. This is called with the
  # controller on every changelog index or permalink view, BEFORE the page renders (a 304 revisit included), so a
  # navbar badge in the same response is current. It may write and runs on every visit: keep it cheap, and write
  # only when something is new. Show `Shiplog.unseen_count(since: user.changelog_seen_at)` (at most 99, counted on
  # approved_at; `helper Shiplog::UnseenHelper` and `shiplog_unseen_count(since)` in views) next to your Changelog
  # link. current_user is often private, hence controller.send (or read a Current attribute).
  # config.on_changelog_seen = lambda do |controller|
  #   user = controller.send(:current_user)
  #   user.update_column(:changelog_seen_at, Time.current) if user && Shiplog.unseen_count(since: user.changelog_seen_at).positive?
  # end

  # The 0.3.0 migration gives entries approved so far their permalink slug. The public pages never write (a GET
  # may hit a read replica), so an entry approved by older code during a deploy window has no permalink until
  # `bin/rails shiplog:backfill_slugs` runs.

  # With your own config.public_layout, add `<%%= shiplog_head_tags %%>` to its <head>: it renders the description,
  # canonical link, robots, Open Graph, Twitter, Atom discovery and JSON-LD tags of the Shiplog pages (and nothing
  # on your other pages). `except: [:feed, ...]` leaves out what your layout writes itself. The older
  # `content_for :shiplog_og`, `:shiplog_description`, `:shiplog_feed`, `:shiplog_robots` and
  # `:shiplog_structured_data` blocks still work but are superseded: use one or the other, never both.

  # The image shared with a permalink page that has no screenshot (og:image, twitter:image, JSON-LD image): a
  # callable evaluated in the view, so route helpers work. Return an http(s) URL or a path (made absolute); an
  # error or any other value is logged and the page gets no image. List pages and the roadmap get none from Shiplog.
  # config.og_image = ->(entry, locale) { main_app.url_for(controller: "/og_images", action: :show, id: entry.slug) }

  # Product areas. The rewriter's reply may name an area (an existing one, or a new name of 1-3 words); Shiplog
  # creates it while fewer than max_areas exist, so the AI cannot sprawl. The changelog offers an area filter
  # (?area=slug) once two areas have published entries. Manage areas in the admin ("Areas"): rename, reorder,
  # merge, delete, and "Detect areas" to backfill entries that have none (it reuses config.rewriter).
  # Entries you set by hand on the edit page are never changed by the AI.
  # config.max_areas = 8

  # Screenshots in entries. They need Active Storage in your app (require "active_storage/engine", and its tables);
  # without it they stay off and Shiplog logs that once at boot. When a draft is written, the images in the GitHub
  # issue or pull request body are attached to the entry (GitHub image hosts only, 5 MB and PNG, JPEG, GIF or
  # WebP at most; the token needs no extra permission). You can also upload images on the entry edit page.
  # config.images = true
  # config.max_images_per_entry = 4

  # Translations of entries. Entries are translated into each of these locales with config.rewriter when they are
  # approved, and again when the English title or body of an approved entry changes; the translation is published
  # at once, with no second approval. One LLM call per entry, locale and change. Admins can edit a translation on
  # the entry page (kept until the English text changes) or retranslate it. Pages render the translation when
  # I18n.locale is one of these and it matches the current English text, and English otherwise. Your routes
  # decide which URLs set the locale (e.g. a /es scope). The default locale is dropped from the list.
  # config.locales = []   # e.g. [:es]

  # Monthly announcements: a short summary of what shipped in a month, drafted by config.rewriter from the month's
  # approved entries and the small changes that got none, and approved in the admin like any entry. Schedule
  # Shiplog::DraftAnnouncementJob early each month (it drafts the previous month), or use the inbox's
  # "Draft announcement" buttons. Where it is published:
  #   :page      (default) Shiplog renders /changelog/2026-10, links it from the month's heading and adds it to the feed
  #   :external  your app publishes it (on_announcement_approved below); the month heading links to announcement_url
  #   false      no announcements
  # config.announcements = :page
  # config.announcement_url = ->(announcement, locale) { main_app.news_path(announcement.slug) }

  # Called with the announcement once it is approved and translated into every configured locale, once per approval
  # (also sent as the `announcement_approved.shiplog` notification). The announcement offers display_title(locale),
  # to_markdown(locale), to_html(locale), to_text(locale) and public_url, to publish it elsewhere or email it.
  # config.on_announcement_approved = ->(announcement) { NewsletterJob.perform_later(announcement) }

  # Newsletter: the approved announcement emailed, in each recipient's language, to your users who opted in and to
  # the visitors who subscribed through Shiplog's form (double opt-in, stored in shiplog_newsletter_subscribers).
  # Sending is an explicit admin action on the announcement's page, once per recipient. Needs newsletter_from,
  # newsletter_address and canonical_url. Schedule Shiplog::PurgeNewsletterJob weekly (unconfirmed addresses).
  # config.newsletter = false

  # Your users who opted in: a callable returning objects (or a relation, read in batches) responding to #email,
  # #locale and #id. Shiplog never stores them. Resolve the locale yourself (the user's, then a default).
  # config.newsletter_recipients = -> { User.where(newsletter: true) }

  # Your own unsubscribe or settings page for those users, linked in the footer as "Preferences". The one-click
  # unsubscribe of mail providers always comes to Shiplog, which calls on_newsletter_unsubscribe below.
  # config.newsletter_unsubscribe_url = ->(user) { Rails.application.routes.url_helpers.settings_url(host: "example.com") }

  # Called with the lowercased email on every unsubscribe (one-click, the footer link, the preferences page), so your
  # own setting follows: Shiplog suppresses the address itself either way, and skips it at send time whatever your
  # list says. When a user opts in again in your app, call Shiplog::Newsletter.resubscribe(user.email) to lift the
  # suppression. Errors are logged, never shown to the visitor.
  # config.on_newsletter_unsubscribe = ->(email) { User.where("lower(email) = ?", email).update_all(newsletter: false) }

  # The sender (also of the confirmation email) and the postal address in the footer (CAN-SPAM requires one).
  # config.newsletter_from = "Acme <updates@example.com>"
  # config.newsletter_address = "Acme Inc., 123 Main Street, Springfield"

  # Branding: the logo (an http(s) URL, shown 140px wide) and the accent colour of buttons and links.
  # config.newsletter_logo_url = "https://example.com/logo.png"
  # config.newsletter_accent = "#0969da"

  # Merged into every newsletter message (not the confirmation email): ActionMailer options or headers your
  # delivery gem reads. With Postmark, a broadcast stream keeps complaints away from your transactional email.
  # config.newsletter_mailer_options = { message_stream: "broadcast" }

  # How many recipients a run claims and emails at a time (Postmark's batch limit by default).
  # config.newsletter_batch_size = 500

  # Callables above cannot be part of the public pages' ETag. Bump this when the output of a callable you
  # configured changes (a new label, another path) so cached pages are refreshed.
  # config.cache_version = nil
end
