<!DOCTYPE html>
<html>
  <head>
    <title>Host admin</title>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <header id="host-admin-header">
      <a id="host-account" href="<%= account_path %>">Account</a>
      <a id="host-admin-home" href="<%= main_app.root_path %>">Host home</a>
      <a id="host-admin-bare-root" href="<%= root_path %>">Bare root_path</a>
      <a id="host-admin-about" href="<%= about_path %>">About</a>
    </header>
    <% if params[:avatar] %>
      <div id="host-avatar">
        <%= image_tag(HostAvatar.new, id: "host-avatar-image") %>
        <%= link_to("Avatar", HostAvatar.new, id: "host-avatar-link") %>
        <span id="host-avatar-url-for"><%= url_for(HostAvatar.new) %></span>
        <span id="host-avatar-polymorphic-path"><%= polymorphic_path(HostAvatar.new) %></span>
        <span id="host-avatar-polymorphic-url"><%= polymorphic_url(HostAvatar.new) %></span>
      </div>
    <% end %>
    <main id="host-admin-main">
      <%= yield %>
    </main>
  </body>
</html>
